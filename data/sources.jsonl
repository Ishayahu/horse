ote": "וַ֭תִּשְׁכַּח כִּי רֶ֣גֶל תְּזוּרֶ֑הָ וְחַיַּ֖ת הַשָּׂדֶ֣ה תְּדוּשֶֽׁהָ"}, {"locator": "Job.39.16", "quote": "הִקְשִׁ֣יחַ בָּנֶ֣יהָ לְּלֹא לָ֑הּ לְרִ֖יק יְגִיעָ֣הּ בְּלִי פָֽחַד"}, {"locator": "Job.39.17", "quote": "כִּֽי הִשָּׁ֣הּ אֱל֣וֹהַּ חָכְמָ֑ה וְלֹא חָ֥לַק לָ֝֗הּ בַּבִּינָֽה"}, {"locator": "Job.39.18", "quote": "כָּ֭עֵת בַּמָּר֣וֹם תַּמְרִ֑יא תִּֽשְׂחַ֥ק לַ֝סּ֗וּס וּלְרֹֽכְבֽוֹ"}, {"locator": "Job.39.19", "quote": "הֲתִתֵּ֣ן לַסּ֣וּס גְּבוּרָ֑ה הֲתַלְבִּ֖ישׁ צַוָּאר֣וֹ רַעְמָֽה"}, {"locator": "Job.39.20", "quote": "הְֽ֭תַרְעִישֶׁנּוּ כָּאַרְבֶּ֑ה ה֖וֹד נַחְר֣וֹ אֵימָֽה"}, {"locator": "Job.39.21", "quote": "יַחְפְּר֣וּ בָ֭עֵמֶק וְיָשִׂ֣ישׂ בְּכֹ֑חַ יֵ֝צֵ֗א לִקְרַאת נָֽשֶׁק"}, {"locator": "Job.39.22", "quote": "יִשְׂחַ֣ק לְ֭פַחַד וְלֹ֣א יֵחָ֑ת וְלֹֽא יָ֝שׁ֗וּב מִפְּנֵי חָֽרֶב"}, {"locator": "Job.39.23", "quote": "עָ֭לָיו תִּרְנֶ֣ה אַשְׁפָּ֑ה לַ֖הַב חֲנִ֣ית וְכִידֽוֹן"}, {"locator": "Job.39.24", "quote": "בְּרַ֣עַשׁ וְ֭רֹגֶז יְגַמֶּא אָ֑רֶץ וְלֹֽא יַ֝אֲמִ֗ין כִּי ק֥וֹל שׁוֹפָֽר"}, {"locator": "Job.39.25", "quote": "בְּדֵ֤י שֹׁפָ֨ר יֹ֘אמַ֤ר הֶאָ֗ח וּֽ֭מֵרָחוֹק יָרִ֣יחַ מִלְחָמָ֑ה רַ֥עַם שָׂ֝רִים וּתְרוּעָֽה"}], "ambiguity_notes": ["Референт перед 39:19 — птица, не конь; конь только объект сравнения её быстроты."], "enriched_from_task": "TAN-001", "period_status": "Historical composition/edition dating not independently established", "confidence": {"quotation": "verified_in_named_digital_witness", "interpretation": "working_contextual_reading"}}
